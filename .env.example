# ============ BACKEND (.env for backend/) ============

# Environment mode (dev, development, local, staging, production)
ENV=development

# REQUIRED: Security key (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=your_secret_key_minimum_32_characters_long_generated_with_secrets_module

# Database Configuration
# Local development (SQLite, no setup needed)
DATABASE_URL=sqlite:///./backend/fashion_app.db

# PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/fashion_app

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fashion_app

# JWT Token Configuration (all in minutes/days)
ACCESS_TOKEN_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
EMAIL_VERIFICATION_EXPIRATION_HOURS=24

# Email Verification (set to false to skip email verification in demo/dev)
EMAIL_VERIFICATION_REQUIRED=true

# SMTP Configuration (for sending verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_ADDRESS=noreply@fashionapp.com
SMTP_USE_TLS=true

# Image Processing
MAX_CONCURRENT_IMAGE_JOBS=4

# Inference Queue (optional, for production scale)
INFERENCE_QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ FRONTEND (.env for frontend/) ============

# Backend API URL (for frontend to communicate with backend)
VITE_API_BASE_URL=http://localhost:8000

# Whether to show email verification prompts
VITE_EMAIL_VERIFICATION_REQUIRED=true
